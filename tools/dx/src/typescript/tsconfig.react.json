{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"]
  },
  "exclude": [
    "${configDir}/**/node_modules",
    "${configDir}/dist",
    "${configDir}/coverage",
    "${configDir}/storybook-static"
  ],
  "include": [
    "${configDir}/**/*.ts",
    "${configDir}/**/*.tsx",
    "${configDir}/**/*.js",
    "${configDir}/**/*.jsx",
    "${configDir}/**/*.cjs",
    "${configDir}/**/*.mjs",
    "${configDir}/**/*.json",
    "${configDir}/.storybook/**/*.ts",
    "${configDir}/.storybook/**/*.tsx"
  ]
}
