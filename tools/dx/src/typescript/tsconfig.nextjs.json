{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.react.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "${configDir}/next-env.d.ts",
    "${configDir}/**/*.ts",
    "${configDir}/**/*.tsx",
    "${configDir}/**/*.js",
    "${configDir}/**/*.jsx",
    "${configDir}/**/*.cjs",
    "${configDir}/**/*.mjs",
    "${configDir}/**/*.json",
    "${configDir}/.storybook/**/*.ts",
    "${configDir}/.storybook/**/*.tsx",
    "${configDir}/.next/types/**/*.ts",
    "${configDir}/.next/dev/types/**/*.ts"
  ]
}
