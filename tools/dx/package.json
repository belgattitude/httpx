{
  "name": "@httpx/dx",
  "version": "0.0.1",
  "private": true,
  "description": "Internal devtools for httpx monorepo",
  "keywords": [],
  "homepage": "https://github.com/belgattitude/httpx",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/httpx.git",
    "directory": "tools/dx"
  },
  "bin": {
    "dx-bench": "./bin/dx-bench.mjs",
    "dx-bench-codspeed": "./bin/dx-bench-codspeed.mjs",
    "dx-build": "./bin/dx-build.mjs",
    "dx-cache": "./bin/dx-cache.mjs",
    "dx-escheck": "./bin/dx-escheck.mjs",
    "dx-oxfmt": "./bin/dx-oxfmt.mjs",
    "dx-oxlint": "./bin/dx-oxlint.mjs",
    "dx-size-limit": "./bin/dx-size-limit.mjs",
    "dx-typecheck": "./bin/dx-typecheck.mjs",
    "dx-typecheck-bun": "./bin/dx-typecheck-bun.mjs",
    "dx-vitest": "./bin/dx-vitest.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "httpx-monorepo-source": "./src/index.ts",
        "default": "./src/index.ts"
      }
    },
    "./oxlint": {
      "import": {
        "httpx-monorepo-source": "./src/oxlint.ts",
        "default": "./src/oxlint.ts"
      }
    },
    "./oxfmt": {
      "import": {
        "httpx-monorepo-source": "./src/oxfmt.ts",
        "default": "./src/oxfmt.ts"
      }
    },
    "./tsdown": {
      "import": {
        "httpx-monorepo-source": "./src/tsdown.ts",
        "default": "./src/tsdown.ts"
      }
    },
    "./vite": {
      "import": {
        "httpx-monorepo-source": "./src/vite.ts",
        "default": "./src/vite.ts"
      }
    },
    "./vitest": {
      "import": {
        "httpx-monorepo-source": "./src/vitest.ts",
        "default": "./src/vitest.ts"
      }
    },
    "./typescript/tsconfig.base.json": "./src/typescript/tsconfig.base.json",
    "./typescript/tsconfig.react.json": "./src/typescript/tsconfig.react.json",
    "./typescript/tsconfig.nextjs.json": "./src/typescript/tsconfig.nextjs.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf --glob ./dist ./build ./coverage './tsconfig*.tsbuildinfo'",
    "format": "oxfmt --write",
    "lint": "ultracite check",
    "lint-fix": "ultracite fix",
    "test-unit": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck-bun": "node ./bin/dx-typecheck-bun.mjs --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@codspeed/vitest-plugin": "6.1.0",
    "@size-limit/esbuild": "14.3.0",
    "@size-limit/file": "14.3.0",
    "@tanstack/eslint-plugin-query": "5.105.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "browserslist": "4.29.5",
    "browserslist-to-esbuild": "2.1.1",
    "es-check": "9.8.1",
    "eslint": "10.13.0",
    "eslint-plugin-security": "4.2.0",
    "happy-dom": "21.0.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-plugin-import-zod": "1.0.1",
    "oxlint-plugin-react-doctor": "0.9.18",
    "oxlint-tailwindcss": "1.16.0",
    "oxlint-tsgolint": "7.0.2005",
    "publint": "0.3.25",
    "size-limit": "14.3.0",
    "tsdown": "0.23.3",
    "typescript": "7.0.2",
    "ultracite": "8.1.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "cross-env": "10.1.0",
    "rimraf": "6.1.3"
  }
}
