{
  "name": "httpx-monorepo",
  "private": true,
  "homepage": "https://github.com/belgattitude/httpx",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": "belgattitude/httpx",
  "type": "module",
  "scripts": {
    "check:security": "pnpm audit",
    "clean:global-cache": "PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false dx-cache clean",
    "clean:turbo": "PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false rimraf .turbo",
    "deps:check": "npm-check-updates --configFileName .ncurc.mjs",
    "deps:update": "npm-check-updates --configFileName .ncurc.mjs -u",
    "g:bench": "turbo run bench --concurrency 1 --filter='!@examples/*' --filter='!httpx-docs'",
    "g:bench-codspeed": "turbo run bench-codspeed --concurrency 1 --filter='./packages/*'",
    "g:build": "turbo run build --filter='!@examples/*' --filter='!httpx-docs'",
    "g:build-examples": "turbo run build --filter='@examples/*'",
    "g:build-packages": "pnpm --filter \"./packages/*\" -r --stream run build",
    "g:build-release": "pnpm --filter \"./packages/*\" -r --stream run build-release",
    "g:changeset": "changeset",
    "g:check-dist": "turbo run check-dist --filter='!@examples/*' --filter='!httpx-docs'",
    "g:check-pub": "turbo run check-pub --filter='!@examples/*' --filter='!httpx-docs'",
    "g:check-size": "turbo run check-size --filter='!@examples/*' --filter='!httpx-docs'",
    "g:ci-coverage-upload": "pnpm -r --if-present --stream run ci-coverage-upload",
    "g:clean": "pnpm clean:global-cache && pnpm -r --parallel --if-present run clean && pnpm clean:turbo",
    "g:docgen": "turbo run docgen --filter='!@examples/*'",
    "g:fix-all-files": "pnpm -r --parallel --if-present run fix-all-files",
    "g:lint": "turbo run lint --continue",
    "g:release": "pnpm run g:build-release && pnpm exec changeset publish",
    "g:test": "pnpm -r --parallel --if-present run test",
    "g:test-unit": "turbo run test-unit --filter='!@examples/*' --filter='!httpx-docs'",
    "g:test-unit-browser": "turbo run test-unit-browser --filter='!@examples/*' --filter='!httpx-docs'",
    "g:test-unit-bun": "turbo run test-unit-bun --filter='!@examples/*' --filter='!httpx-docs'",
    "g:test-unit-cloudflare": "turbo run test-unit-cloudflare --filter='!@examples/*' --filter='!httpx-docs'",
    "g:test-unit-coverage": "turbo run test-unit-coverage --filter='!@examples/*' --filter='!httpx-docs'",
    "g:test-unit-edge": "turbo run test-unit-edge --filter='!@examples/*' --filter='!httpx-docs'",
    "g:typecheck": "turbo run typecheck",
    "g:typecheck-bun": "turbo run typecheck-bun",
    "install:playwright": "pnpm --filter @httpx/devtools-vitest run install-playwright",
    "nuke:node_modules": "PNPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=false rimraf --glob \"**/node_modules\"",
    "pnpm:reinstall": "pnpm pm clean --lockfile --config.verifyDepsBeforeRun=false && pnpm install",
    "postinstall": "lefthook install",
    "syncpack:check": "syncpack lint-semver-ranges --types prod,dev --source \"package.json\" --source \"packages/*/package.json\"",
    "syncpack:format": "syncpack format",
    "syncpack:list": "syncpack list-semver-ranges --types prod,dev --source \"package.json\" --source \"packages/*/package.json\"",
    "website:build": "pnpm --filter httpx-docs run build",
    "website:deploy": "gh-pages -d ./docs/out -t"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@httpx/dx": "workspace:^",
    "@types/node": "26.6.5",
    "cross-env": "10.1.0",
    "gh-pages": "6.3.0",
    "lefthook": "2.2.1",
    "npm-check-updates": "23.1.1",
    "npm-run-all2": "9.0.3",
    "pkg-pr-new": "0.0.91",
    "playwright": "1.64.0",
    "rimraf": "6.1.3",
    "syncpack": "15.3.3",
    "turbo": "2.11.8",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.13.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.13.0"
}
