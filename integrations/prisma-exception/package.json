{
  "name": "prisma-exception",
  "version": "0.1.0",
  "description": "Prisma errors to http exceptions.",
  "keywords": [
    "http exception",
    "prisma"
  ],
  "homepage": "https://github.com/belgattitude/httpx/tree/main/integrations/prisma-exception#readme",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/httpx.git",
    "directory": "integrations/prisma-exception"
  },
  "files": [
    "dist",
    "README.md",
    "package.json",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm run clean && dx-build",
    "build-release": "pnpm run build",
    "check-dist": "es-check es2022 './dist/**/*.js' --not './dist/*.map.js' --module",
    "check-pub": "attw --pack --profile esm-only && publint",
    "check-size": "size-limit",
    "clean": "rimraf ./dist ./coverage ./tsconfig.tsbuildinfo",
    "docgen": "run-s docgen-typedoc",
    "docgen-typedoc": "rimraf ./docs/api && typedoc --plugin typedoc-plugin-markdown --out ./docs/api",
    "format": "dx-oxfmt --write",
    "lint": "dx-oxfmt --check --no-error-on-unmatched-pattern && dx-oxlint",
    "lint-fix": "dx-oxlint --fix && dx-oxfmt --write",
    "lint-timing": "cross-env TIMING=1 pnpm run lint",
    "test": "vitest run",
    "test-unit-coverage-disabled": "vitest run --coverage",
    "test-unit-disabled": "vitest run",
    "test-unit-watch": "vitest --ui",
    "typecheck": "dx-typecheck --project tsconfig.json --noEmit",
    "typecheck-build": "dx-typecheck --project tsconfig.build.json --noEmit",
    "typecheck-bun": "dx-typecheck-bun --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@httpx/exception": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@httpx/devtools-vitest": "workspace:^",
    "@httpx/dx": "workspace:^",
    "@size-limit/file": "14.3.0",
    "@size-limit/webpack": "14.3.0",
    "@size-limit/webpack-why": "14.3.0",
    "@types/node": "26.6.5",
    "@vitest/ui": "5.0.5",
    "browserslist": "4.29.4",
    "browserslist-to-esbuild": "2.1.1",
    "cross-env": "10.1.0",
    "es-check": "9.8.1",
    "esbuild": "0.28.2",
    "npm-run-all2": "9.0.4",
    "publint": "0.3.25",
    "rimraf": "6.1.3",
    "size-limit": "14.3.0",
    "tsdown": "0.23.2",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "webpack": "5.112.1"
  },
  "engines": {
    "node": ">=22.14"
  }
}
