{
  "name": "@httpx/jwt-verify",
  "version": "0.4.2",
  "description": "Verify JSON Web Tokens (JWT)",
  "keywords": [
    "azure-ad",
    "entra",
    "jsonwebtoken",
    "jwt",
    "jwt-verify",
    "lru",
    "openid",
    "standard schema"
  ],
  "homepage": "https://belgattitude.github.io/httpx/jwt-verify",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/httpx.git",
    "directory": "packages/jwt-verify"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "httpx-monorepo-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bench-bun-disabled": "dx-bench --runtime=bun",
    "bench-codspeed-disabled": "dx-bench-codspeed",
    "bench-disabled": "dx-bench",
    "bench-watch-disabled": "dx-bench --watch",
    "build": "dx-build",
    "build-release": "pnpm run build",
    "check-dist": "es-check es2022 './dist/**/*.js' --not './dist/*.map.js' --module",
    "check-pub": "attw --pack --profile esm-only && publint",
    "check-size": "size-limit",
    "ci-coverage-upload": "../../.github/scripts/download/codecov -F httpx-jwt-verify-unit --dir ./coverage",
    "clean": "rimraf --glob ./dist ./build ./coverage './tsconfig*.tsbuildinfo'",
    "dev": "dx-build --watch",
    "docgen": "run-s docgen-typedoc",
    "docgen-typedoc": "rimraf ./docs/api && typedoc --plugin typedoc-plugin-markdown --out ./docs/api",
    "format": "dx-oxfmt --write",
    "lint": "dx-oxfmt --check --no-error-on-unmatched-pattern && dx-oxlint",
    "lint-fix": "dx-oxlint --fix && dx-oxfmt --write",
    "test": "vitest run",
    "test-unit": "vitest run",
    "test-unit-browser": "vitest run --browser",
    "test-unit-bun": "bun --bun run vitest run",
    "test-unit-cloudflare-disabled": "vitest run --config ./vitest.cloudflare.config.ts",
    "test-unit-coverage": "vitest run --coverage",
    "test-unit-edge": "vitest run --environment edge-runtime",
    "test-unit-watch": "vitest --ui --api 4515",
    "typecheck": "dx-typecheck --project tsconfig.json --noEmit",
    "typecheck-build": "dx-typecheck --project tsconfig.build.json --noEmit",
    "typecheck-bun": "dx-typecheck-bun --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@httpx/lru": "workspace:^",
    "@httpx/plain-object": "workspace:^",
    "jose": "^6.2.12",
    "ky": "^2.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@azure/identity": "4.14.0",
    "@dotenvx/dotenvx": "2.38.0",
    "@httpx/devtools-vitest": "workspace:^",
    "@httpx/dx": "workspace:^",
    "@size-limit/esbuild": "14.2.0",
    "@size-limit/file": "14.2.0",
    "@standard-schema/spec": "1.1.0",
    "aws-jwt-verify": "5.2.1",
    "browserslist": "4.29.3",
    "browserslist-to-esbuild": "2.1.1",
    "es-check": "9.8.1",
    "nock": "15.0.2",
    "npm-run-all2": "9.0.3",
    "publint": "0.3.25",
    "rimraf": "6.1.3",
    "size-limit": "14.2.0",
    "tsdown": "0.23.1",
    "tsx": "4.23.15",
    "type-fest": "5.10.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "7.0.2",
    "valibot": "1.5.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@standard-schema/spec": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@standard-schema/spec": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
