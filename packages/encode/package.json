{
  "name": "@httpx/encode",
  "version": "0.3.1",
  "description": "Base encodings, ie base64...",
  "keywords": [
    "base convert",
    "base64",
    "encoding"
  ],
  "homepage": "https://belgattitude.github.io/httpx/encode",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/httpx.git",
    "directory": "packages/encode"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "httpx-monorepo-source": "./src/index.ts",
        "types": "./dist/index.d.ts",
        "bun": "./dist/index.uint8.js",
        "deno": "./dist/index.uint8.js",
        "node": "./dist/index.node20.js",
        "browser": "./dist/index.browser.js",
        "default": "./dist/index.default.js"
      }
    },
    "./base64/base64.purejs": {
      "import": {
        "httpx-monorepo-source": "./src/base64/base64.purejs.ts",
        "types": "./dist/base64/base64.purejs.d.ts",
        "default": "./dist/base64/base64.purejs.js"
      }
    },
    "./base64/base64.atob": {
      "import": {
        "httpx-monorepo-source": "./src/base64/base64.atob.ts",
        "types": "./dist/base64/base64.atob.d.ts",
        "default": "./dist/base64/base64.atob.js"
      }
    },
    "./base64/base64.uint8array": {
      "import": {
        "httpx-monorepo-source": "./src/base64/base64.uint8array.ts",
        "types": "./dist/base64/base64.uint8array.d.ts",
        "default": "./dist/base64/base64.uint8array.js"
      }
    },
    "./base64/base64.node20": {
      "import": {
        "httpx-monorepo-source": "./src/base64/base64.node20.ts",
        "types": "./dist/base64/base64.node20.d.ts",
        "default": "./dist/base64/base64.node20.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bench": "dx-bench",
    "bench-bun": "dx-bench --runtime=bun",
    "bench-codspeed": "dx-bench-codspeed",
    "bench-watch": "dx-bench --watch",
    "build": "pnpm run clean && dx-build",
    "build-release": "pnpm run build",
    "check-dist": "run-s check-dist-esm",
    "check-dist-esm": "es-check es2022 './dist/**/*.js' --not './dist/*.map.js' --module",
    "check-pub": "attw --pack --profile esm-only && publint",
    "check-size": "size-limit",
    "ci-coverage-upload": "../../.github/scripts/download/codecov -F httpx-encode-unit --dir ./coverage",
    "clean": "rimraf --glob ./dist ./build ./coverage './tsconfig*.tsbuildinfo'",
    "dev": "dx-build --watch",
    "docgen": "run-s docgen-typedoc",
    "docgen-typedoc": "rimraf ./docs/api && typedoc --plugin typedoc-plugin-markdown --out ./docs/api",
    "format": "dx-oxfmt --write",
    "lint": "dx-oxfmt --check --no-error-on-unmatched-pattern && dx-oxlint",
    "lint-fix": "dx-oxlint --fix && dx-oxfmt --write",
    "test": "vitest run",
    "test-unit": "vitest run",
    "test-unit-browser": "vitest run --browser",
    "test-unit-bun": "bun --bun run vitest run",
    "test-unit-cloudflare": "vitest run --config ./vitest.cloudflare.config.ts",
    "test-unit-coverage": "vitest run --coverage",
    "test-unit-edge": "vitest run --environment edge-runtime",
    "test-unit-watch": "vitest --ui --api 4515",
    "typecheck": "dx-typecheck --project tsconfig.json --noEmit",
    "typecheck-build": "dx-typecheck --project tsconfig.build.json --noEmit",
    "typecheck-bun": "dx-typecheck-bun --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@httpx/devtools-vitest": "workspace:^",
    "@httpx/dx": "workspace:^",
    "@sindresorhus/is": "8.1.0",
    "@size-limit/file": "14.2.0",
    "@size-limit/webpack": "14.2.0",
    "@types/node": "26.6.5",
    "browserslist": "4.29.3",
    "browserslist-to-esbuild": "2.1.1",
    "es-check": "9.8.1",
    "esbuild": "0.28.2",
    "esbuild-fix-imports-plugin": "1.0.23",
    "esbuild-plugin-file-path-extensions": "2.1.4",
    "is-ci": "4.1.0",
    "js-base64": "3.9.4",
    "npm-run-all2": "9.0.3",
    "pretty-bytes": "7.2.0",
    "publint": "0.3.25",
    "rimraf": "6.1.3",
    "size-limit": "14.2.0",
    "tsdown": "0.23.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "7.0.2",
    "uint8array-extras": "1.6.0",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "webpack": "5.111.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
