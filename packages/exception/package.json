{
  "name": "@httpx/exception",
  "version": "4.1.0",
  "description": "HTTP response errors with default message, stacktrace, instanceof, error cause support and more.",
  "keywords": [
    "http error",
    "http exception",
    "http response error",
    "http status",
    "http status code"
  ],
  "homepage": "https://github.com/belgattitude/httpx/tree/main/packages/exception#readme",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/httpx.git",
    "directory": "packages/exception"
  },
  "files": [
    "dist",
    "README.md",
    "UPGRADE.md",
    "package.json",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "httpx-monorepo-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./experimental": {
      "httpx-monorepo-source": "./src/experimental/index.ts",
      "types": "./dist/experimental/index.d.ts",
      "default": "./dist/experimental/index.js"
    },
    "./serializer": {
      "httpx-monorepo-source": "./src/serializer/index.ts",
      "types": "./dist/serializer/index.d.ts",
      "default": "./dist/serializer/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bench": "dx-bench",
    "bench-bun": "dx-bench --runtime=bun",
    "bench-watch": "dx-bench --watch",
    "build": "pnpm run clean && dx-build",
    "build-release": "pnpm run build",
    "check-dist": "es-check es2022 './dist/**/*.js' --not './dist/*.map.js' --module",
    "check-pub": "attw --pack --profile esm-only && publint",
    "check-size": "size-limit && pnpm run check-treeshake",
    "check-treeshake": "node ./scripts/check-treeshake.mjs",
    "ci-coverage-upload": "../../.github/scripts/download/codecov -F httpx-exception-unit --dir ./coverage",
    "clean": "rimraf ./dist ./coverage ./tsconfig.tsbuildinfo",
    "docgen": "run-s docgen-typedoc",
    "docgen-typedoc": "rimraf ./docs/api && typedoc --plugin typedoc-plugin-markdown --out ./docs/api",
    "fix-all-files": "dx-oxlint --fix && dx-oxfmt --write",
    "format": "dx-oxfmt --write",
    "lint": "dx-oxfmt --check --no-error-on-unmatched-pattern && dx-oxlint",
    "lint-fix": "dx-oxlint --fix && dx-oxfmt --write",
    "lint-timing": "cross-env TIMING=1 pnpm run lint",
    "test": "vitest run",
    "test-unit": "vitest run",
    "test-unit-browser": "vitest run --browser=chromium",
    "test-unit-bun": "bun --bun run vitest run",
    "test-unit-cloudflare": "vitest run --config ./vitest.cloudflare.config.ts",
    "test-unit-coverage": "vitest run --coverage",
    "test-unit-watch": "vitest --ui  --api 4212",
    "typecheck": "dx-typecheck --project tsconfig.json --noEmit",
    "typecheck-build": "dx-typecheck --project tsconfig.build.json --noEmit",
    "typecheck-bun": "dx-typecheck-bun --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@httpx/devtools-vitest": "workspace:^",
    "@httpx/dx": "workspace:^",
    "@size-limit/file": "14.3.0",
    "@size-limit/webpack": "14.3.0",
    "@size-limit/webpack-why": "14.3.0",
    "@types/node": "26.6.5",
    "@types/statuses": "2.0.6",
    "browserslist": "4.29.4",
    "browserslist-to-esbuild": "2.1.1",
    "cross-env": "10.1.0",
    "es-check": "9.8.1",
    "esbuild": "0.28.2",
    "npm-run-all2": "9.0.3",
    "publint": "0.3.25",
    "rimraf": "6.1.3",
    "rolldown": "1.2.15",
    "size-limit": "14.3.0",
    "statuses": "2.0.2",
    "superjson": "2.2.6",
    "tsdown": "0.23.1",
    "tupleson": "0.23.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "webpack": "5.112.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
