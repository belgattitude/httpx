{
  "name": "@httpx/json-api",
  "version": "0.8.2",
  "description": "Basic typescript helpers to work with json-api",
  "keywords": [
    "helpers",
    "json-api"
  ],
  "homepage": "https://github.com/belgattitude/httpx/tree/main/packages/json-api#readme",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/httpx.git",
    "directory": "packages/json-api"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "httpx-monorepo-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bench": "dx-bench",
    "bench-watch": "dx-bench --watch",
    "build": "pnpm run clean && dx-build",
    "build-release": "pnpm run build",
    "check-dist": "es-check es2022 './dist/**/*.js' --not './dist/*.map.js' --module",
    "check-pub": "attw --pack --profile esm-only && publint",
    "check-size": "size-limit",
    "ci-coverage-upload": "../../.github/scripts/download/codecov -F httpx-json-api-unit --dir ./coverage",
    "clean": "rimraf --glob ./dist ./build ./coverage './tsconfig*.tsbuildinfo'",
    "dev": "dx-build --watch",
    "docgen": "run-s docgen-typedoc",
    "docgen-typedoc": "rimraf ./docs/api && typedoc --plugin typedoc-plugin-markdown --out ./docs/api",
    "format": "dx-oxfmt --write",
    "lint": "dx-oxfmt --check --no-error-on-unmatched-pattern && dx-oxlint",
    "lint-fix": "dx-oxlint --fix && dx-oxfmt --write",
    "test": "vitest run",
    "test-unit": "vitest run",
    "test-unit-browser": "vitest run --browser",
    "test-unit-bun": "bun --bun run vitest run",
    "test-unit-cloudflare": "vitest run --config ./vitest.cloudflare.config.ts",
    "test-unit-coverage": "vitest run --coverage",
    "test-unit-edge": "vitest run --environment edge-runtime",
    "test-unit-watch": "vitest --ui  --api 4313",
    "typecheck": "dx-typecheck --project tsconfig.json --noEmit",
    "typecheck-build": "dx-typecheck --project tsconfig.build.json --noEmit",
    "typecheck-bun": "dx-typecheck-bun --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@httpx/exception": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@httpx/devtools-vitest": "workspace:^",
    "@httpx/dx": "workspace:^",
    "@size-limit/file": "14.2.0",
    "@size-limit/webpack": "14.2.0",
    "browserslist": "4.29.3",
    "browserslist-to-esbuild": "2.1.1",
    "es-check": "9.8.1",
    "esbuild": "0.28.2",
    "npm-run-all2": "9.0.3",
    "publint": "0.3.25",
    "rimraf": "6.1.3",
    "size-limit": "14.2.0",
    "tsdown": "0.23.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "webpack": "5.112.0"
  },
  "engines": {
    "node": ">=22.14"
  }
}
