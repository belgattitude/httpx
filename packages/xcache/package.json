{
  "name": "@httpx/xcache",
  "version": "0.8.1",
  "description": "Memory cache for node and browsers",
  "keywords": [
    "cache"
  ],
  "homepage": "https://belgattitude.github.io/httpx/xcache",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/httpx.git",
    "directory": "packages/xcache"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "httpx-monorepo-source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bench": "dx-bench",
    "bench-bun": "dx-bench --runtime=bun",
    "bench-codspeed": "dx-bench-codspeed",
    "bench-watch": "dx-bench --watch",
    "build": "pnpm run clean && dx-build",
    "build-release": "pnpm run build",
    "check-dist": "run-s check-dist-esm check-dist-cjs",
    "check-dist-cjs": "es-check es2022 './dist/**/*.cjs' --not './dist/*.map.js'",
    "check-dist-esm": "es-check es2022 './dist/**/*.js' --not './dist/*.map.js' --module",
    "check-pub": "attw --pack && publint",
    "check-size": "size-limit",
    "ci-coverage-upload": "../../.github/scripts/download/codecov -F httpx-xcache --dir ./coverage",
    "clean": "rimraf --glob ./dist ./build ./coverage './tsconfig*.tsbuildinfo'",
    "dev": "dx-build --watch",
    "docgen": "run-s docgen-typedoc",
    "docgen-typedoc": "rimraf ./docs/api && typedoc --plugin typedoc-plugin-markdown --out ./docs/api",
    "format": "dx-oxfmt --write",
    "lint": "dx-oxfmt --check --no-error-on-unmatched-pattern && dx-oxlint",
    "lint-fix": "dx-oxlint --fix && dx-oxfmt --write",
    "test": "vitest run",
    "test-unit": "vitest run",
    "test-unit-browser": "vitest run --browser",
    "test-unit-bun": "bun --bun run vitest run",
    "test-unit-cloudflare": "vitest run --config ./vitest.cloudflare.config.ts",
    "test-unit-coverage": "vitest run --coverage",
    "test-unit-edge": "vitest run --environment edge-runtime",
    "test-unit-watch": "vitest --ui --api 4515",
    "typecheck": "dx-typecheck --project tsconfig.json --noEmit",
    "typecheck-build": "dx-typecheck --project tsconfig.build.json --noEmit",
    "typecheck-bun": "dx-typecheck-bun --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@httpx/compress": "workspace:^",
    "@httpx/lru": "workspace:^",
    "@httpx/stable-hash": "workspace:^"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@httpx/devtools-vitest": "workspace:^",
    "@httpx/dx": "workspace:^",
    "@size-limit/file": "14.2.0",
    "@size-limit/webpack": "14.2.0",
    "browserslist": "4.29.3",
    "browserslist-to-esbuild": "2.1.1",
    "devalue": "6.0.2",
    "es-check": "9.8.1",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "npm-run-all2": "9.0.3",
    "pretty-bytes": "7.2.0",
    "publint": "0.3.25",
    "rimraf": "6.1.3",
    "size-limit": "14.2.0",
    "superjson": "2.2.6",
    "tsdown": "0.23.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "webpack": "5.111.1"
  },
  "peerDependencies": {
    "devalue": "^5.4.2 || ^6.0.0",
    "superjson": "^2.2.5"
  },
  "peerDependenciesMeta": {
    "devalue": {
      "optional": true
    },
    "superjson": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
