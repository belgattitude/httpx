{
  "name": "@httpx/devtools-vitest",
  "version": "0.0.2",
  "private": true,
  "description": "Shareable dev setups for vitest",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/httpx.git",
    "directory": "devtools/vitest"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./wrangler.toml": "./wrangler.toml"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf ./dist ./build ./coverage ./_release",
    "fix-staged": "lint-staged --allow-empty",
    "format": "dx-oxfmt --write",
    "install-playwright": "playwright install chromium",
    "lint": "dx-oxfmt --check --no-error-on-unmatched-pattern && dx-oxlint",
    "lint-fix": "dx-oxlint --fix && dx-oxfmt --write",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@codspeed/vitest-plugin": "5.7.1",
    "@edge-runtime/vm": "5.0.0",
    "@testing-library/dom": "10.4.1",
    "@types/estree": "1.0.9",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-istanbul": "4.1.10",
    "@vitest/runner": "4.1.10",
    "@vitest/snapshot": "4.1.10",
    "@vitest/ui": "4.1.10",
    "ci-info": "4.4.0",
    "esbuild": "0.28.2",
    "is-ci": "4.1.0",
    "playwright": "1.62.1",
    "tinybench": "6.1.3",
    "type-fest": "5.8.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vitest-browser-react": "2.2.0"
  },
  "devDependencies": {
    "@httpx/dx": "workspace:^",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "baseline-browser-mapping": "2.11.14",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "0.22.14",
    "unrun": "0.3.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
