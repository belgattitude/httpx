{
  "name": "@httpx/devtools-vitest",
  "version": "0.0.2",
  "private": true,
  "description": "Shareable dev setups for vitest",
  "license": "MIT",
  "author": {
    "name": "Vanvelthem Sébastien",
    "url": "https://github.com/belgattitude"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belgattitude/httpx.git",
    "directory": "devtools/vitest"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./wrangler.toml": "./wrangler.toml"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rimraf ./dist ./build ./coverage ./_release",
    "format": "dx-oxfmt --write",
    "install-playwright": "playwright install chromium",
    "lint": "dx-oxfmt --check --no-error-on-unmatched-pattern && dx-oxlint",
    "lint-fix": "dx-oxlint --fix && dx-oxfmt --write",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cloudflare/vitest-plugin": "1.4.2",
    "@codspeed/vitest-plugin": "5.7.1",
    "@edge-runtime/vm": "5.0.0",
    "@testing-library/dom": "10.4.2",
    "@types/estree": "1.0.9",
    "@vitest/browser": "5.0.4",
    "@vitest/browser-playwright": "5.0.4",
    "@vitest/coverage-istanbul": "5.0.4",
    "@vitest/snapshot": "5.0.4",
    "@vitest/ui": "5.0.4",
    "ci-info": "4.4.0",
    "esbuild": "0.28.2",
    "is-ci": "4.1.0",
    "playwright": "1.64.0",
    "tinybench": "6.2.2",
    "type-fest": "5.10.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vitest-browser-react": "2.3.0"
  },
  "devDependencies": {
    "@httpx/dx": "workspace:^",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "baseline-browser-mapping": "2.11.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "0.23.1",
    "unrun": "0.3.1",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
