{
  "name": "@examples/nextjs-app",
  "version": "0.1.128",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env TSCONFIG=./tsconfig.no-paths.json next build",
    "clean": "rimraf ./.next ./coverage ./tsconfig.tsbuildinfo",
    "dev": "next dev",
    "fix-staged": "lint-staged --allow-empty",
    "format": "dx-oxfmt --write",
    "lint": "next typegen && dx-oxfmt --check --no-error-on-unmatched-pattern && dx-oxlint",
    "lint-fix": "next typegen && dx-oxlint --fix && dx-oxfmt --write",
    "start": "next start",
    "test": "vitest run",
    "test-unit": "vitest run",
    "test-unit-watch": "vitest --ui",
    "typecheck": "next typegen && tsc --project tsconfig.json --noEmit",
    "typecheck-no-paths": "next typegen && tsc --project tsconfig.no-paths.json --noEmit",
    "typegen": "next typegen"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "@httpx/assert": "workspace:^",
    "@httpx/compress": "workspace:^",
    "@httpx/dsn-parser": "workspace:^",
    "@httpx/encode": "workspace:^",
    "@httpx/exception": "workspace:^",
    "@httpx/lru": "workspace:^",
    "@httpx/memo-intl": "workspace:^",
    "@httpx/plain-object": "workspace:^",
    "@httpx/stable-hash": "workspace:^",
    "@httpx/treeu": "workspace:^",
    "@httpx/xcache": "workspace:^",
    "clsx": "2.1.1",
    "hono": "4.13.1",
    "ky": "2.0.2",
    "next": "16.3.0",
    "pino": "10.3.1",
    "primereact": "10.9.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "superjson": "2.2.6",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@httpx/dx": "workspace:^",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "cross-env": "10.1.0",
    "happy-dom": "20.11.2",
    "postcss": "8.5.26",
    "rimraf": "6.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "4.1.10",
    "webpack": "5.109.2"
  }
}
