{
  "name": "httpx-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run generate-readme-docs && next build",
    "clean": "rimraf ./.next ./out /coverage ./tsconfig.tsbuildinfo",
    "dev": "pnpm run generate-readme-docs && next dev",
    "format": "dx-oxfmt --write",
    "generate-readme-docs": "node scripts/generate-readme-docs.ts",
    "lint": "next typegen && dx-oxfmt --check --no-error-on-unmatched-pattern && dx-oxlint",
    "lint-fix": "dx-oxlint --fix && dx-oxfmt --write",
    "start": "sirv ./out --cors --port 8888",
    "typecheck": "next typegen && dx-typecheck --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "cn": "0.5.0",
    "fumadocs-core": "16.17.6",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.7",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-raw": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@httpx/dx": "workspace:^",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.30",
    "rimraf": "6.1.3",
    "sirv": "3.0.2",
    "sirv-cli": "3.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
