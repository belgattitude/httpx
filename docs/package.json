{
  "name": "httpx-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "clean": "rimraf ./.next ./out /coverage ./tsconfig.tsbuildinfo",
    "dev": "next dev",
    "export": "next export",
    "format": "dx-oxfmt --write",
    "lint": "dx-oxfmt --check --no-error-on-unmatched-pattern && dx-oxlint",
    "lint-fix": "dx-oxlint --fix && dx-oxfmt --write",
    "start": "sirv ./out --cors --port 8888",
    "typecheck": "tsgo --project ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "next": "16.3.0",
    "nextra": "3.3.1",
    "nextra-theme-docs": "3.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@httpx/dx": "workspace:^",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "postcss": "8.5.26",
    "rimraf": "6.1.3",
    "sirv": "3.0.2",
    "sirv-cli": "3.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
